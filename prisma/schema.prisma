generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  workflows Workflow[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcpConnections  UserMcpConnection[]
  mcpConnectAttempts McpConnectAttempt[]
  mcpServers      McpServer[]         @relation("UserOwnedMcpServers")
}

enum McpTransport {
  HTTP
  SSE
  STDIO
}

enum McpAuthType {
  NONE
  API_KEY
  COMPOSIO
}

enum McpConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  REVOKED
}

model McpServer {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  iconUrl     String?
  docsUrl     String?

  url       String?
  transport McpTransport @default(HTTP)
  authType  McpAuthType  @default(COMPOSIO)

  composioToolkit String?

  composioAuthConfigId String?

  composioAuthScheme String?

  composioManagedAuth Boolean @default(false)

  categories String[]

  popularity Int @default(0)

  isEnabled Boolean @default(true)

  ownerId String?
  owner   User?   @relation("UserOwnedMcpServers", fields: [ownerId], references: [id], onDelete: Cascade)

  connections UserMcpConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([isEnabled, popularity(sort: Desc)])
  @@index([categories], type: Gin)
}

model UserMcpConnection {
  id       String @id @default(cuid())
  userId   String
  serverId String

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  server McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)

  status McpConnectionStatus @default(PENDING)

  credential String?

  externalAccountId String?

  accountLabel String?
  lastError String?

  connectedAt DateTime?
  lastUsedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serverId])
  @@index([userId])
}

model McpConnectAttempt {
  id       String @id @default(cuid())
  state    String @unique
  userId   String
  serverId String
  returnTo String?

  externalRequestId String?

  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([expiresAt])
}

enum WorkflowTrigger {
  MANUAL
  SCHEDULE
  WEBHOOK
  ONCE
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model Workflow {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?

  graph Json

  graphVersion Int @default(1)

  serverSlugs String[]

  trigger   WorkflowTrigger @default(MANUAL)
  isEnabled Boolean         @default(false)

  cron String?

  timezone String?

  runAt DateTime?

  nextRunAt DateTime?
  lastRunAt DateTime?

  runs     WorkflowRun[]
  versions WorkflowVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
  @@index([serverSlugs], type: Gin)
  @@index([isEnabled, nextRunAt])
}

model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  revision     Int
  graph        Json
  graphVersion Int
  note         String?

  createdAt DateTime @default(now())

  @@unique([workflowId, revision])
  @@index([workflowId, createdAt(sort: Desc)])
}

model WorkflowRun {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status  RunStatus       @default(QUEUED)
  trigger WorkflowTrigger

  dryRun Boolean @default(false)

  graphSnapshot Json
  graphVersion  Int

  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  output     Json?

  stepRuns WorkflowStepRun[]

  createdAt DateTime @default(now())

  @@index([workflowId, createdAt(sort: Desc)])
  @@index([status])
}

model WorkflowStepRun {
  id    String      @id @default(cuid())
  runId String
  run   WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  nodeId String

  serverSlug String?
  toolSlug   String?

  status  RunStatus @default(QUEUED)
  attempt Int       @default(1)

  input  Json?
  output Json?
  error  String?

  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([runId, nodeId, attempt])
  @@index([runId])
  @@index([serverSlug, status])
}
