# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# Runtime connection used by the app (src/lib/db.ts).
# Production: use your provider's POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/somethingai_dev?schema=public"

# Connection used by the Prisma CLI for migrations (prisma7.config.ts).
# Must be DIRECT / unpooled. Locally, same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/somethingai_dev?schema=public"

# Clerk (auth). From the Clerk dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk (webhooks). From the Clerk dashboard -> Webhooks -> your endpoint's
# signing secret. Used by src/app/api/webhooks/clerk/route.ts to verify that
# incoming requests actually came from Clerk before touching the database.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."

# Public origin of this app. Used to build the callback URL handed to Composio,
# so it must match the origin the browser actually uses. In production set this
# to your real https:// origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encrypts stored MCP credentials before they are written to Postgres
# (src/lib/crypto.ts). Must be 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes existing stored credentials undecryptable, so users would
# have to reconnect any API-key servers.
MCP_TOKEN_ENCRYPTION_KEY=""

# Composio (https://app.composio.dev) brokers the provider OAuth flow and hosts
# the MCP servers, so Gmail needs no Google Cloud project and no Workspace
# Developer Preview enrollment.
#
#   COMPOSIO_API_KEY               Settings -> API Keys in the Composio dashboard.
#                                  Required to connect any catalog server.
#   COMPOSIO_GMAIL_AUTH_CONFIG_ID  Optional. Pre-seeds the Gmail auth config
#                                  ("ac_...") instead of letting the app create
#                                  a Composio-managed one on first connect. Set
#                                  this only if you want to bring your own
#                                  Google OAuth credentials.
COMPOSIO_API_KEY=""
COMPOSIO_GMAIL_AUTH_CONFIG_ID=""

# Scheduler (src/app/api/cron/tick/route.ts). Any long random string:
#   openssl rand -base64 32
# The tick endpoint runs other people's workflows, so it refuses to do
# anything at all unless this is set. Send it as a bearer token:
#   curl -H "Authorization: Bearer $CRON_SECRET" localhost:3000/api/cron/tick
CRON_SECRET="a-long-random-string"

# Optional. Model used for `llm` steps at run time, which can be cheaper and
# faster than the one that designs workflows. Falls back to OPENAI_MODEL.
OPENAI_STEP_MODEL="gpt-5.5"
