# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# Runtime connection used by the app (src/lib/db.ts).
# Production: use your provider's POOLED connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/somethingai_dev?schema=public"

# Connection used by the Prisma CLI for migrations (prisma7.config.ts).
# Must be DIRECT / unpooled. Locally, same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/somethingai_dev?schema=public"

# Clerk (auth). From the Clerk dashboard -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk (webhooks). From the Clerk dashboard -> Webhooks -> your endpoint's
# signing secret. Used by src/app/api/webhooks/clerk/route.ts to verify that
# incoming requests actually came from Clerk before touching the database.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_..."
