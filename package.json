{
  "name": "somethingai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --names web,worker --prefix-colors blue,magenta \"npm:dev:web\" \"npm:worker\"",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:sync-composio": "tsx prisma/sync-composio.ts",
    "db:studio": "prisma studio --port 5555",
    "typecheck": "tsc --noEmit",
    "worker": "cd worker && go run ./cmd/worker",
    "worker:test": "cd worker && go test ./...",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "^7.9.1",
    "@clerk/ui": "^1.40.2",
    "@composio/core": "^0.18.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "16.3.4",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
