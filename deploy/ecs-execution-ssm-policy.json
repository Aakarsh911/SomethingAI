{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWorkerSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:us-east-2:635738234685:parameter/somethingai/*"
    },
    {
      "Sid": "DecryptSecureStrings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.us-east-2.amazonaws.com" }
      }
    }
  ]
}
